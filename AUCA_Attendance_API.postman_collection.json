        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns new token pair', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json.data.token).to.be.a('string');",
                  "  pm.expect(json.data.refreshToken).to.be.a('string');",
                  "  pm.collectionVariables.set('admin_token', json.data.token);",
                  "  pm.collectionVariables.set('admin_refresh_token', json.data.refreshToken);",
                  "  console.log('✅ Tokens rotated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{admin_refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/refresh"
          }
        },
